#!/bin/sh
# Persist boot logs + diagnostics to /boot (FAT partition, survives reboot)

case "$1" in
  start)
    # Immediate write test (no sleep delay)
    echo "$(date): S99save_dmesg started" > /boot/init-test.log 2>&1
    
    # Check if /boot is actually mounted and writable
    if mount | grep -q "/boot"; then
        echo "$(date): /boot mounted successfully" >> /boot/init-test.log
    else
        echo "$(date): ERROR - /boot not mounted" >> /boot/init-test.log
        # Try manual mount as fallback
        mount /dev/mmcblk0p1 /boot 2>>/boot/init-test.log && \
            echo "$(date): Manual mount succeeded" >> /boot/init-test.log
    fi

    sleep 5  # Let all init scripts complete
    
    {
      echo "=== Kernel Messages ==="
      dmesg
      
      echo ""
      echo "=== Network Interfaces ==="
      ip addr show
      
      echo ""
      echo "=== SSH Status ==="
      ps | grep sshd
      netstat -tlnp 2>/dev/null | grep :22 || ss -tlnp | grep :22
      
      echo ""
      echo "=== PTY Status ==="
      mount | grep devpts
      ls -la /dev/pts/ 2>/dev/null || echo "/dev/pts not mounted"
      
      echo ""
      echo "=== Loaded Modules ==="
      lsmod
      
    } > /boot/last-boot-debug.log 2>&1
    ;;
esac
